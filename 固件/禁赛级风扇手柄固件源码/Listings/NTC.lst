             -set+(-15+i);
  95   1      for(i=0;i<52;i++)
  96   1        {
  97   2        NTCTableValue=(unsigned long)NTCTableBottom[i];
  98   2        NTCTableValue&=0xFFFF;
  99   2        if(NTCTableValue<=NTCRes)return (int)TemperatureReportOffset+(35+i);
 100   2        }
