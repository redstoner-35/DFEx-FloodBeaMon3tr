  19          /* Global Function implementation - (in header files with 'extern')
  20          ****************************************************************************/ 
  21          
  22          //解锁/上锁Flash
  23          void SetFlashState(bit IsUnlocked)
  24            {
  25   1        //禁止中断并解锁flash
  26   1        if(IsUnlocked)
  27   1          {
  28   2          EA=0;
  29   2          _nop_();
  30   2          MLOCK = 0xAA; 
  31   2          }
  32   1        //重新打开中断并锁住Flash
  33   1        else
  34   1          {
  35   2          MLOCK = 0x55;   
  36   2          _nop_();
  37   2          EA=1; //重新启用中断
  38   2          }
  39   1        }
  40            
  41          //读取数据
  42          void Flash_Operation(FlashOperationDef Operation,int ADDR,char *Data)
  43            {
  44   1        if(Operation==DataFlash_Write)MDATA=*Data; //写入模式下需要写数据 
  45   1        MADRL = ADDR&0xFF;
  46   1        MADRH = (ADDR>>8)&0xFF; //设置地址
  47   1        _nop_();  
  48   1        MCTRL = (unsigned char)Operation; //对数据区进行读取操作
  49   1        _nop_();
  50   1        _nop_();
  51   1        _nop_();
  52   1        _nop_();
  53   1        _nop_();
C51 COMPILER V9.60.7.0   FLASH                                                             10/31/2026 08:53:26 PAGE 2   

  54   1        _nop_();
  55   1        while(MCTRL & 0x01); //等待读取结束
  56   1        if(Operation==DataFlash_Read)*Data=MDATA; //返回数据
  57   1        }
