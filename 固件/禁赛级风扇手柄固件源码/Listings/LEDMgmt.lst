 185            
 186          //制造一次快闪
 187          void MakeFastStrobe(LEDStateDef LEDMode)
 188            {
 189   1        //打开LED
 190   1        switch(LEDMode)
 191   1          {
 192   2          case LED_Green:RLED=0;GLED=1;break;//绿色LED
 193   2          case LED_Red:RLED=1;GLED=0;break;//红色LED
 194   2          case LED_Amber:RLED=1;GLED=1;break;//黄色LED
 195   2          default:return; //非法值
 196   2          }
 197   1        delay_ms(20);
 198   1        //关闭LED
 199   1        RLED=0;
 200   1        GLED=0;
 201   1        } 
