  94            
  95          //LED控制函数
  96          void LEDControlHandler(void)
  97            {
  98   1        char buf;
  99   1        //进行温控警告模式指示
 100   1        if(IsThermalStepdown())
 101   1          {
 102   2          if(BoostModeInfoTIM>16)BoostModeInfoTIM=0;  //定时器大于16，清零到初始值
 103   2            else if(BoostModeInfoTIM==12||BoostModeInfoTIM==16) //在定时器处于12和16的时候，强制关闭
             -一次LED触发熄灭效果
 104   2            {
 105   3            BoostModeInfoTIM++;
 106   3            RLED=0;
 107   3            GLED=0;
 108   3            return;            //在特定时刻，让LED短暂熄灭并退出
 109   3            }   
 110   2          else BoostModeInfoTIM++; //计时器继续累加
 111   2          }
 112   1        //进行狂暴模式工作指示
C51 COMPILER V9.60.7.0   LEDMGMT                                                           10/31/2026 08:53:28 PAGE 3   

 113   1        else if(QueryIsSystemInBoostMode())
 114   1          {
 115   2          if(BoostModeInfoTIM<12)BoostModeInfoTIM++;
 116   2          else
 117   2            {
 118   3            BoostModeInfoTIM=0;
 119   3            RLED=0;
 120   3            GLED=0;
 121   3            return;            //清零定时器，让LED短暂熄灭并退出
 122   3            }
 123   2          }
 124   1        else BoostModeInfoTIM=0;    
 125   1        //据目标模式设置LED状态
 126   1        switch(LEDMode)
 127   1          {
 128   2          case LED_OFF:RLED=0;GLED=0;timer=0;break; //LED关闭
 129   2          case LED_Green:RLED=0;GLED=1;break;//绿色LED
 130   2          case LED_Red:RLED=1;GLED=0;break;//红色LED
 131   2          case LED_Amber:RLED=1;GLED=1;break;//黄色LED
 132   2          case LED_AmberBlinkFast:
 133   2            //黄色快闪
 134   2            timer=timer&0x80?0x00:0x80; //翻转bit 7并重置定时器
 135   2            if(!(timer&0x80))
 136   2              {
 137   3              RLED=0;
 138   3              GLED=0;
 139   3              }
 140   2            else
 141   2              {
 142   3              RLED=1;
 143   3              GLED=1;       
 144   3              }
 145   2            break;
 146   2          case LED_RedBlink_Fast: //红色快闪  
 147   2          case LED_RedBlink: //红色闪烁
 148   2            GLED=0;
 149   2            buf=timer&0x7F; //读取当前定时器的控制位
 150   2            if(buf<(LEDMode==LED_RedBlink?3:0))
 151   2              {
 152   3              buf++;
 153   3              timer&=0x80;
 154   3              timer|=buf; //时间没到，继续计时
 155   3              }
 156   2            else timer=timer&0x80?0x00:0x80; //翻转bit 7并重置定时器
 157   2            RLED=timer&0x80?1:0; //根据bit 7载入LED控制位
 158   2            break;
 159   2          case LED_GreenBlinkThird:
 160   2          case LED_RedBlinkThird: //LED红色闪烁3次
 161   2          case LED_RedBlinkFifth: //LED红色闪烁5次
 162   2          case LED_AmberBlinkFifth:
 163   2            timer&=0x7F; //去掉最上面的位
 164   2            if(timer>((LEDMode==LED_RedBlinkThird||LEDMode==LED_GreenBlinkThird)?6:10))LEDMode=LED_OFF; //时间到
             -，关闭识别
 165   2            else if((timer++)%2)//继续计时,符合条件则点亮LED
 166   2              {
 167   3              //根据LED颜色输出对应的指令，点亮对应的LED
 168   3              if(LEDMode==LED_AmberBlinkFifth){GLED=1;RLED=1;}
 169   3              else if(LEDMode==LED_GreenBlinkThird){GLED=1;RLED=0;}
 170   3              else {GLED=0;RLED=1;}
 171   3              }   
 172   2            else 
 173   2              {
C51 COMPILER V9.60.7.0   LEDMGMT                                                           10/31/2026 08:53:28 PAGE 4   

 174   3              //不符合条件LED熄灭
 175   3              RLED=0;
 176   3              GLED=0;
 177   3              }
 178   2            break;
 179   2          }
 180   1        }
