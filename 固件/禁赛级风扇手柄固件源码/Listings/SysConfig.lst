 200          /****************************************************************************/
 201          /* Global Function implementation - exported for Config operation
 202          ****************************************************************************/     
 203          
 204          //读取驱动的系统配置
 205          void ReadSysConfig(void)
 206            {
 207   1        xdata SysROMImg ROMData;
 208   1        //读取数据
 209   1        CurrentIdx=SearchSysConfig(&ROMData);
 210   1        //进行读出数据的校验
 211   1        if(ROMData.Data.CheckSum==PEC8Check(ROMData.Data.SysConfig.ByteBuf,sizeof(SysStorDef)))
 212   1          {
 213   2          //校验成功，加载数据
 214   2          IsEnableBattCfgLock=ROMData.Data.SysConfig.Data.BitfieldMem1&IsEnableBattCfgLock_MSK?1:0;
 215   2          IsEnable2SMode=ROMData.Data.SysConfig.Data.BitfieldMem1&IsEnable2SMode_MSK?1:0;
 216   2          IsEnableIdleLED=ROMData.Data.SysConfig.Data.BitfieldMem1&IsEnableIdleLED_MSK?1:0;
 217   2          IsSystemLocked=ROMData.Data.SysConfig.Data.BitfieldMem1&IsLocked_MSK?1:0;
 218   2          RampDuty=ROMData.Data.SysConfig.Data.RampDuty;
 219   2          RampVoltage=ROMData.Data.SysConfig.Data.RampVout;
 220   2          //存储当前的index值
 221   2          CurrentCRC=ROMData.Data.CheckSum;
 222   2          CurrentIdx++; //当前位置有数据，需要让index+1移动到未写入的位置
 223   2          
 224   2          //用户按下按键，重置设置并重启
 225   2          if(!GetSideKeyRawGPIOState())ResetSysConfigToDefault();
 226   2          }
 227   1        //校验失败重建数据
 228   1        else 
 229   1          {
 230   2          PrepareFactoryDefaultCfg(); 
 231   2          IsSystemLocked=1;  //系统刷写固件后首次上电，使系统处于锁定状态
 232   2          SaveSysConfig(1);  //重建数据后立即保存参数
 233   2          ShowEPROMCorrupted(); //显示EEPROM损坏
 234   2          }
 235   1        //读取操作完毕，锁定flash 
C51 COMPILER V9.60.7.0   SYSCONFIG                                                         10/31/2026 08:53:28 PAGE 5   

 236   1        SetFlashState(0);
 237   1        }
 238          
 239          //保存驱动的系统配置到Flash（可以选择是强制覆写还是跳过一样内容的保存以节约ROM写入次数）
 240          void SaveSysConfig(bit IsForceSave)
 241            {
 242   1        unsigned char i,BFBuf=0;
 243   1        xdata SysROMImg SavedData;
 244   1        //解锁flash（CRC校验模块需要读取Flash所以需要解锁）
 245   1        SetFlashState(1);
 246   1        //开始进行数据构建
 247   1        if(IsSystemLocked)BFBuf|=IsLocked_MSK;                     //是否锁定
 248   1        if(IsEnableIdleLED)BFBuf|=IsEnableIdleLED_MSK;             //是否开启有源夜光
 249   1        if(IsEnable2SMode)BFBuf|=IsEnable2SMode_MSK;               //是否开启2S模式
 250   1        if(IsEnableBattCfgLock)BFBuf|=IsEnableBattCfgLock_MSK;          //是否开启电池配置锁
 251   1          
 252   1        SavedData.Data.SysConfig.Data.BitfieldMem1=BFBuf;
 253   1        SavedData.Data.SysConfig.Data.RampDuty=RampDuty;
 254   1        SavedData.Data.SysConfig.Data.RampVout=RampVoltage;
 255   1        SavedData.Data.CheckSum=PEC8Check(SavedData.Data.SysConfig.ByteBuf,sizeof(SysStorDef)); //计算CRC
 256   1        //进行数据比对
 257   1        if(!IsForceSave&&SavedData.Data.CheckSum==CurrentCRC)
 258   1          {
 259   2          SetFlashState(0);//读取操作完毕，锁定flash  
 260   2          return; //跳过保存操作，数据相同  
 261   2          }
 262   1        //数据需要保存，开始检测是否需要擦除
 263   1        if(IsForceSave||CurrentIdx>=SysCfgGroupLen) 
 264   1          {
 265   2          //数据已经写满了，对扇区0和1进行完全擦除
 266   2          Flash_Operation(DataFlash_Erase,0x200,&i);  //扇区2=512-1023
 267   2          Flash_Operation(DataFlash_Erase,0,&i);      //扇区1=0-511
 268   2          //从第0个位置开始写入
 269   2          CurrentIdx=0;
 270   2          }
 271   1        //写入数据
 272   1        for(i=0;i<sizeof(SysROMImageDef);i++)Flash_Operation(DataFlash_Write,i+(CurrentIdx*sizeof(SysROMImg)),&Sa
             -vedData.ByteBuf[i]);  
 273   1        CurrentIdx++; //本index已被写入，标记写到下个idx
 274   1        CurrentCRC=SavedData.Data.CheckSum; //保存本次index的CRC8
 275   1        SetFlashState(0);//写入操作完毕，锁定flash  
 276   1        } 
