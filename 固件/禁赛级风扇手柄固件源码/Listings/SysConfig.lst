 106          /****************************************************************************/
 107          /* Local Function implementation - EEPROM operation
 108          ****************************************************************************/ 
 109          
 110          //从EEPROM内寻找最后的一组系统配置
 111          static int SearchSysConfig(SysROMImg *ROMData)
 112            {
 113   1        unsigned char i;
 114   1        int Len=0;
C51 COMPILER V9.60.7.0   SYSCONFIG                                                         10/31/2026 08:53:28 PAGE 3   

 115   1        //解锁flash并开始读取
 116   1        SetFlashState(1);
 117   1        do
 118   1          {   
 119   2          for(i=0;i<sizeof(SysROMImageDef);i++)Flash_Operation(DataFlash_Read,i+(Len*sizeof(SysROMImg)),&ROMData->
             -ByteBuf[i]); //从ROM内读取数据
 120   2          if(ROMData->Data.CheckSum!=PEC8Check(ROMData->Data.SysConfig.ByteBuf,sizeof(SysStorDef)))break; //找到了
             -没有被写入CRC校验不过的地方，就是你了
 121   2          Len++;
 122   2          }
 123   1        while(Len<SysCfgGroupLen);
 124   1        //读取上一组正确的配置
 125   1        if(Len>0)Len--;
 126   1        for(i=0;i<sizeof(SysROMImageDef);i++)Flash_Operation(DataFlash_Read,i+(Len*sizeof(SysROMImg)),&ROMData->B
             -yteBuf[i]);
 127   1        //读取结束，返回上一组有数据的index
 128   1        return Len;
 129   1        }
 130          //准备初始的系统设置
 131          static void PrepareFactoryDefaultCfg(void)
 132            {
 133   1        RampVoltage=VMinMaxCfg.SysMinVolt;
 134   1        RampDuty=(float)VMinMaxCfg.SysMinSpeed;
 135   1        IsSystemLocked=0;
 136   1        IsEnableIdleLED=1;
 137   1        
 138   1        #ifndef EnableHyper1S   
                  
                //关闭超级1S模式，允许电池配置锁解除
                IsEnableBattCfgLock=0;
                IsEnable2SMode=0;
                  
                #else
 145   1          
 146   1        //开启超级1S模式，此时强制上配置锁并且禁止切换到2S
 147   1        IsEnableBattCfgLock=1;
 148   1        IsEnable2SMode=0;
 149   1      
 150   1        #endif    
 151   1        } 
 152            
 153          //尝试检测用户进行重置操作  
 154          static void ResetSysConfigToDefault(void)
 155            {
 156   1        unsigned char delay;
 157   1        bit BattCfgLockState;
 158   1        //如果系统处于锁定状态，则不允许重置出厂设置
 159   1        if(IsSystemLocked)return;
 160   1        //准备初始的系统设置
 161   1        BattCfgLockState=IsEnableBattCfgLock;
 162   1        PrepareFactoryDefaultCfg();
 163   1        if(BattCfgLockState)IsEnableBattCfgLock=1; //进行配置锁的记忆确保锁定后除了重新刷固件没有解锁的办法
 164   1        //保存数据并显示状态
 165   1        SaveSysConfig(0); //写数据写成默认值
 166   1        SetFlashState(0); //锁定Flash
 167   1        //配置指示灯准备显示
 168   1        delay=100;
 169   1        LEDMode=LED_AmberBlinkFast; //LED模式配置为黄色快闪
 170   1        do
 171   1          {
 172   2          delay_ms(10);
 173   2          LEDControlHandler();
C51 COMPILER V9.60.7.0   SYSCONFIG                                                         10/31/2026 08:53:28 PAGE 4   

 174   2          //松开按键后开始计时
 175   2          if(GetSideKeyRawGPIOState())delay--;
 176   2          }
 177   1        while(delay);
 178   1        //触发系统重启
 179   1        TriggerSoftwareReset();
 180   1        } 
 181            
 182          //显示系统数据存在错误
 183          static void ShowEPROMCorrupted(void)
 184            {
 185   1        unsigned char delay=0xFF;
 186   1        //读取操作完毕，锁定flash 
 187   1        SetFlashState(0);
 188   1        //配置LED模式
 189   1        LEDMode=LED_RedBlink; //LED模式配置为红色快闪
 190   1        while(--delay)
 191   1          {
 192   2          delay_ms(10);
 193   2          LEDControlHandler();
 194   2          }
 195   1        //时间到，令系统reboot
 196   1        TriggerSoftwareReset();
 197   1        }
