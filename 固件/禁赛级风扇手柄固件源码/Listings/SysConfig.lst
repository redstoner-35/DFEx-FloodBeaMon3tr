  79          /****************************************************************************/
  80          /* Local Function implementation - Checksum value Calculation
  81          ****************************************************************************/   
  82            
  83          //CRC-8计算 
  84          static u8 PEC8Check(char *DIN,char Len)
  85          {
  86   1       unsigned char crcbuf=0xFF;
  87   1       unsigned char i;
  88   1       do
  89   1        {
  90   2        //载入数据
  91   2        crcbuf^=*DIN++;
  92   2        //计算
  93   2        i=8;
  94   2        do
  95   2         {
  96   3         if(crcbuf&0x80)crcbuf=(crcbuf<<1)^0x07;//最高位为1，左移之后和多项式XOR
  97   3         else crcbuf<<=1;//最高位为0，只移位不XOR
  98   3         }
  99   2        while(--i);
 100   2        }
 101   1       while(--Len);
 102   1       //输出结果
 103   1       return crcbuf;
 104   1      }
