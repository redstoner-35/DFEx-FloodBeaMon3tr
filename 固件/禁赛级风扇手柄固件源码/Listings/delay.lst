  21          /****************************************************************************/
  22          /*  Global variable definitions(declared in header file with 'extern')
  23          ****************************************************************************/
  24          volatile bit SysHFBitFlag;        //高频心跳Flag(65.5mS)
  25          
  26          /****************************************************************************/
  27          /*  Local variable definitions ('static')
  28          ****************************************************************************/
  29          static volatile bit IntDivFlag;             //内部分频flag
  30          static volatile bit IsT0OVF;            //T0已溢出
  31          
  32          /****************************************************************************/
  33          /*  Local TMR Interrupt Handler (ISR Routine)
  34          ****************************************************************************/ 
  35          
  36          //系统心跳定时器的中断处理  
  37          void Timer2_IRQHandler(void) interrupt TMR2_VECTOR
  38            { 
  39   1        T2IF=0x00; //清零T2中断
  40   1        //进行爆闪2分频
  41   1        IntDivFlag=~IntDivFlag; //TStrobe=31.25*2=62.5mS
  42   1        if(IntDivFlag)SysHFBitFlag=1;  //每62.5mS将flag置1
  43   1        }   
  44            
  45          //软件延时定时器的中断处理
  46          void Timer0_IRQHandler(void) interrupt TMR0_VECTOR  //0x0B 
  47            {
  48   1        TCON&=0xEF; //清除溢出标记位
  49   1        IsT0OVF=1;
  50   1        }   
  51          
  52          /****************************************************************************/
  53          /*  Global function implantation for Timebase Initialization
C51 COMPILER V9.60.7.0   DELAY                                                             10/31/2026 08:53:25 PAGE 2   

  54          ****************************************************************************/ 
  55          void StartSystemTimeBase(void)
  56            {
  57   1        //启动延时函数
  58   1        TCON&=0xCF; //清除溢出标记位，关闭定时器
  59   1        TMOD&=0xF0;
  60   1        TMOD|=0x01; //T0设置为使用Fext,16bit向上计数模式
  61   1        TH0=0x00;
  62   1        TL0=0x00; //初始化数值
  63   1        
  64   1        //配置T2心跳定时器模式      
  65   1        CCEN=0x00; //关闭比较和捕获
  66   1        RLDH=0x0B;
  67   1        RLDL=0xDB; //将重装载值设置为产生31.25mS延迟(1/32秒)，计算公式为65535-(48/24(0.5uS)=2000*31.25mS)=3035[0x
             -0BDB]
  68   1        TH2=0x5D;
  69   1        TL2=0x66; //将计数器设置为产生31.25mS延迟的初值 
  70   1        
  71   1        //启用中断
  72   1        T2IF=0x00; //清零T2中断
  73   1        T2IE=0x80; //令T2OVIE=1，启用T2 OVF中断
  74   1        IE=0xA2; //令ET0=1，ET2=1，分别启用T0和T2的定时中断,EA=1，启用全局总中断
  75   1        
  76   1        //复位flag并启动心跳定时器
  77   1        SysHFBitFlag=0;
  78   1        IntDivFlag=0;  //复位所有flag
  79   1        T2CON=0x91; //设置T2时钟源为fSys/24=1MHz，定时器立即启动
  80   1        }
  81          
  82          /****************************************************************************/
  83          /*  Global function implantation for actual delay function
  84          ****************************************************************************/ 
  85          void delay_ms(int ms)
  86            {
  87   1        unsigned long CNT;
  88   1        unsigned char repcounter=0;
  89   1        //计算定时器重装值
  90   1        if(ms==0)return;
  91   1        do
  92   1          {
  93   2          repcounter++; //重复计数器+1
  94   2          CNT=(long)ms*4000; //T0一个周期是48/12=4MHz=0.25uS
  95   2          CNT/=(long)repcounter; //除以重复次数得到单次计数值
  96   2          }
  97   1        while(CNT>0xFFFF); //反复循环确保定时器值小于65535
  98   1        CNT=0xFFFF-CNT; //计算结束，将16bit计数器满的值加载到定时器内
  99   1        //开始进行单次或多次倒计时
 100   1        do
 101   1          {     
 102   2          //装载定时器值
 103   2          TH0=(CNT>>8)&0xFF;
 104   2          TL0=CNT&0xFF; 
 105   2          IsT0OVF=0; //复位标志位
 106   2          //启动定时器开始倒计时
 107   2          TCON|=0x10; //TR0=1,定时器开始计时  
 108   2          while(!(TCON&0x20)&&!IsT0OVF); //等待直到T0溢出
 109   2          //计时结束，准备进行下一轮
 110   2          TCON&=0xCF; //清除溢出标记位，关闭定时器
 111   2          repcounter--; //重复次数-1
 112   2          }
 113   1        while(repcounter);
 114   1        }
