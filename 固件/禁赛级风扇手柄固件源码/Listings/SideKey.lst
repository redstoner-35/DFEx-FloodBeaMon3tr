 114          //在单击双击三击+长按触发的时候清除单击事件的记录并执行多击+长按事件登记
             -的处理
 115          static void ClickAndHoldEventHandler(int PressCount)
 116            {
 117   1        KeyTimer[1]=0; //关闭后部检测定时器
 118   1        Keyevent.ShortPressEvent=0;
 119   1        Keyevent.ShortPressCount=0; //短按次数为0
 120   1        Keyevent.LongPressDetected=0;
 121   1        //多击+长按
 122   1        Keyevent.HoldStat=(HoldEventDef)(PressCount+1);
 123   1        }
