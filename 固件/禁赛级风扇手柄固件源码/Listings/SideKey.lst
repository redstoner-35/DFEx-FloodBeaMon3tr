 129          
 130          //初始化侧按键
 131          void SideKeyInit(void)
 132            {
 133   1        GPIOCfgDef KeyInitCfg;
 134   1        //设置结构体
 135   1        KeyInitCfg.Mode=GPIO_IPU;
 136   1        KeyInitCfg.Slew=GPIO_Slow_Slew;   
 137   1        KeyInitCfg.DRVCurrent=GPIO_Low_Current; //配置为上拉输入
 138   1        //按键输入初始化
 139   1        GPIO_SetMUXMode(SideKeyGPIOG,SideKeyGPIOx,GPIO_AF_GPIO); //配置为GPIO      
 140   1        GPIO_ConfigGPIOMode(SideKeyGPIOG,GPIOMask(SideKeyGPIOx),&KeyInitCfg);//按键输入
 141   1        GPIO_EnableInt(SideKeyGPIOG,GPIOMask(SideKeyGPIOx)); //使能中断功能
 142   1        GPIO_SetExtIntMode(SideKeyGPIOG,SideKeyGPIOx,GPIO_Int_Falling);//设置为下降沿触发
 143   1        EIP1|=0x04; //将按键中断设置为高优先级
 144   1        //初始化结构体内容和定时器
 145   1        KeyState=0xFF;
 146   1        KeyTimer[0]=0x00;
 147   1        KeyTimer[1]=0x00;
 148   1        Keyevent.ShortPressCount=0;
 149   1        Keyevent.ShortPressEvent=0;
 150   1        Keyevent.HoldStat=HoldEvent_None;
 151   1        }
 152          
 153          //侧按按键计时模块
 154          void SideKey_TIM_Callback(void)
 155            {
 156   1        unsigned char buf,i,Time;
 157   1        extern bit IsTacMode;
 158   1        //定时器处理（其中0用于短按/长按判断计时，1用于连续短按终止计时）
 159   1        for(i=0;i<2;i++)if(KeyTimer[i]&0x80)
 160   1          {
 161   2          buf=KeyTimer[i]&0x7F;
 162   2          if(!i)Time=(unsigned char)LongPressTime;
 163   2          else Time=(unsigned char)ContShortPressWindow;
 164   2          if(buf<Time)buf++;
 165   2          KeyTimer[i]&=0x80;
 166   2          KeyTimer[i]|=buf; //将数值取出来，加1再写回去
 167   2          }
 168   1        }
 169          
 170          //侧按键逻辑处理函数
 171          void SideKey_LogicHandler(void)
C51 COMPILER V9.60.7.0   SIDEKEY                                                           10/31/2026 08:53:27 PAGE 4   

 172            {   
 173   1        unsigned char buf;
 174   1        extern bit IsTacMode;
 175   1        //对按键进行去抖以及重新打开中断的判断
 176   1        if(!GPIO_CheckIfIntEnabled(SideKeyGPIOG,GPIOMask(SideKeyGPIOx)))
 177   1          {
 178   2          //进行按键检查
 179   2          KeyState<<=1;
 180   2          if(KeyPress)KeyState++;//附加结果
 181   2          //重新打开中断
 182   2          buf=KeyState&KeyReleaseDetectMask;  
 183   2          if(buf==KeyReleaseDetectMask||buf==0x00)
 184   2            {
 185   3            ClearKeyIntFlag();//清除按键响应的Flag
 186   3            IsKeyPressed=buf==KeyReleaseDetectMask?0:1; //更新按键状态  
 187   3            GPIO_SetExtIntMode(SideKeyGPIOG,SideKeyGPIOx,buf==KeyReleaseDetectMask?GPIO_Int_Falling:GPIO_Int_Rising
             -);//如果当前按键是松开状态则设置为下降沿，否则设置为上升沿
 188   3            GPIO_EnableInt(SideKeyGPIOG,GPIOMask(SideKeyGPIOx)); //使能中断功能
 189   3            }
 190   2          } 
 191   1        //如果按键释放等待计时器在计时的话，则重置定时器
 192   1        if(IsKeyPressed&&(KeyTimer[1]&0x80))KeyTimer[1]=0x80;
 193   1        //长按3秒的时间到
 194   1        if(IsKeyPressed&&KeyTimer[0]==(0x80+(unsigned char)LongPressTime))
 195   1          {
 196   2          //处理多击+长按事件
 197   2          if(Keyevent.ShortPressCount>0)ClickAndHoldEventHandler(Keyevent.ShortPressCount);
 198   2          else //长按事件
 199   2            {
 200   3            Keyevent.ShortPressCount=0;
 201   3            Keyevent.HoldStat=HoldEvent_H;//长按事件发生
 202   3            Keyevent.LongPressDetected=1;//长按检测到了  
 203   3            }
 204   2          KeyTimer[0]=0;//关闭定时器
 205   2          }
 206   1        //连续短按序列已经结束
 207   1        if(!IsKeyPressed&&KeyTimer[1]==(0x80+(unsigned char)ContShortPressWindow))
 208   1          {
 209   2          KeyTimer[1]=0;//关闭定时器1
 210   2          if(!Keyevent.LongPressDetected) 
 211   2            Keyevent.ShortPressEvent=1;//如果长按事件已经生效，则松开开关时短按事件不生效
 212   2          else 
 213   2            Keyevent.LongPressDetected=0; //清除长按检测到的结果
 214   2          }
 215   1        }
