 220          //标记按键按下
 221          void MarkAsKeyPressed(void)
 222            { 
 223   1        //标记按键已被按下
 224   1        IsKeyPressed = 1;//标记按键按下
 225   1        if(KeyTimer[1]&0x80)KeyTimer[1]=0x80;//复位
 226   1        if(!(KeyTimer[0]&0x80))KeyTimer[0]=0x80;//启动计时
 227   1        }   
