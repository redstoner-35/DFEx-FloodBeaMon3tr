  81          
  82          //GPIO中断回调处理函数
  83          void Key_IRQHandler(void) interrupt SideKeyIRQ 
  84            {
  85   1        unsigned char time;
  86   1        //开始响应
  87   1        if(GPIO_GetExtIntMode(SideKeyGPIOG,SideKeyGPIOx)==GPIO_Int_Rising)
  88   1          {
  89   2          IsKeyPressed = 0;
  90   2          time=KeyTimer[0]&0x7F;//从计时器取出按键按下时间
  91   2          KeyTimer[0]=0;//复位并关闭定时器0
  92   2          if(Keyevent.LongPressDetected||Keyevent.HoldStat!=HoldEvent_None)//如果已经检测到长按事件则�
             -��面什么都不做
  93   2            {
  94   3            Keyevent.HoldStat=HoldEvent_None;
  95   3            Keyevent.LongPressDetected=0;//清除检测到的表示
  96   3            }
  97   2          else if(time<(unsigned char)LongPressTime)//短按事件发生      
  98   2            {
  99   3            if(Keyevent.ShortPressCount<8)Keyevent.ShortPressCount++;//累加有效的短按次数
 100   3            KeyTimer[1]=0x80;//启动短按完毕等待统计的计时器
 101   3            }     
 102   2          }
 103   1        //按键按下，调用标记函数
 104   1        else MarkAsKeyPressed();
 105   1        //关闭侧按中断并进行按键Flag清除
 106   1        SideKey_SetIntOFF();
 107   1        ClearKeyIntFlag();
 108   1        }
