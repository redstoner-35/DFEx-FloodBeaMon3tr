 104          static int SetFanPWMProcess(void)
 105            {
 106   1        float buf,DutyLimit;
 107   1        //È¡ÊýÖµ
 108   1        if(!IsEnablePWMFan)buf=100; //µçÑ¹Ä£Ê½PWMÈ«¸ß
 109   1        else if(TargetfanSpeed>100)buf=100;
 110   1        else buf=TargetfanSpeed;            //ÏÞÖÆÊýÖµ
 111   1        #ifndef EnableHyper1S 
                  
                if(!IsEnable2SMode)buf*=DualLit1SFanLimitRatio;
                  
C51 COMPILER V9.60.7.0   OUTPUTCHANNEL                                                     10/31/2026 08:53:28 PAGE 3   

                #endif  
 116   1        //ÔØÈëÎÂ¿Ø²ÎÊý  
 117   1        DutyLimit=QueryDutyLimit();
 118   1        if(DutyLimit>100)DutyLimit=100; 
 119   1        if(DutyLimit<0)DutyLimit=0;     //Õ¼¿Õ±È²ÎÊýÏÞ·ù
 120   1        buf*=DutyLimit/(float)100; 
 121   1        if(buf>FanPWMMaxRatio)buf=(float)FanPWMMaxRatio;            //Ó¦ÓÃ½µ¶îÏµÊýÏÞÖÆ·çÉÈ×î¸ßËÙ¶È
 122   1        if(buf<VMinMaxCfg.SysMinSpeed)buf=VMinMaxCfg.SysMinSpeed;   //¶ÔËÙ¶È²ÎÊý½øÐÐ°Ù·Ö±ÈÏÞ·ù        
 123   1          
 124   1          
 125   1          
 126   1        //³ËÒÔPWM StepÈ»ºó³ýÒÔ100µÃµ½PWMÈ¡Öµ
 127   1        buf*=FanPWMStepConstant();
 128   1        buf/=(float)100;
 129   1        //ÏÞÖÆ²ÎÊýÈ¡ÖµÎª0-FanPWMStepConstant
 130   1        if(buf<(float)FanPWMStepConstant())return (int)buf;
 131   1        return FanPWMStepConstant;
 132   1        }
