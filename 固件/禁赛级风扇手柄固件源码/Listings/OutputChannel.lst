 134          //¸ù¾Ý´«ÈëµçÑ¹¼ÆËãCV DAC PWMÕ¼¿Õ±ÈµÄº¯Êý
 135          static void SetCVDACProcess(float VIN)
 136            { 
 137   1        float buf;
 138   1      
 139   1        //ÊäÈë²ÎÊýÏÞ·ù
 140   1        if(VIN>MaxFanVoltageClamp)buf=MaxFanVoltageClamp;
 141   1        else if(VIN>11.98)buf=11.98;
 142   1        else if(VIN<5.1)buf=5.1;
 143   1        else buf=VIN;
 144   1          
 145   1        //ÔØÈëÎÂ¿Ø²ÎÊý½øÐÐµçÑ¹ÏÞ·ù
 146   1        if(buf<QueryVoltageLimit())
 147   1          {
 148   2          buf=QueryVoltageLimit();
 149   2          if(buf<VMinMaxCfg.SysMinVolt)buf=VMinMaxCfg.SysMinVolt;
 150   2          }     
 151   1        //¿ªÊ¼µ÷ÓÃÄ§·¨¹«Ê½¼ÆËã
 152   1        buf=0.4314*(buf-(float)1);
 153   1        buf=4.7288-buf; //¼ÆËãµÃ³öÔË·ÅÊä³öµÄÄ¿±êµçÑ¹
 154   1        buf=buf/Data.MCUVDD; 
 155   1        buf*=100; //ºÍµ±Ç°MCUµÄVINµçÑ¹Ïà³ýµÃµ½PWMDACµÄÕ¼¿Õ±È
 156   1        if(buf<0)buf=0;
 157   1        if(buf>100)buf=100; //Õ¼¿Õ±ÈÊýÖµÖ»ÄÜÊÇ0ºÍ100
 158   1        //¼ÆËãÍê±Ï£¬Ð´CVDACµÄPWM
 159   1        CVDACTargetDuty=buf;  
 160   1        }
