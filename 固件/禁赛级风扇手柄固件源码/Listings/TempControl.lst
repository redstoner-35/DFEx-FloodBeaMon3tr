 137          void TempDegDetect(void)
 138            {
 139   1        float NewVLIM,NewDLim;
 140   1        //NTC¹ÊÕÏ»òÕß×ª»»Î´Íê³É£¬²»Ö´ĞĞ
 141   1        if(!Data.IsNTCOK||!IsADResultOK)return;
