 143   1        //Ö´ĞĞ½µµµÖ¸Ê¾ÅĞ¶Ï
 144   1        if(Data.Systemp>ThrottleMaintainTemp)IsThermalThrottle=1;
 145   1        else if(IsThermalThrottle&&Data.Systemp<NoThrottleTemp)IsThermalThrottle=0; 
 146   1          
 147   1        //Ã»ÓĞ½µµµ»òÕßÏµÍ³´¦ÓÚ¹Ø±Õ×´Ì¬£¬²»ÏŞÖÆ
 148   1        if(CurrentMode->ModeIdx==Mode_OFF||!IsThermalThrottle)
 149   1          {
