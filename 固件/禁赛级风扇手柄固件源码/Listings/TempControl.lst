 151   2          NewDLim=NoThrottleDutylim;
 152   2          }
 153   1        //´¥·¢½µµµ£¬µ±Ç°ÊÇPWMÄ£Ê½£¬Ö´ĞĞPWM»ı·ÖÎÂ¿Ø»ºÂı½µµÍ³öÁ¦
 154   1        else if(IsEnablePWMFan)
 155   1          {
 156   2          //Õ¼¿Õ±È²¿·ÖµÄ»ı·ÖÎÂ¿Ø
 157   2          NewDLim=(float)(Data.Systemp-ThrottleMaintainTemp); //¼ÆËãÎó²îÖµ
 158   2          if(Data.Systemp>(PowerOffTemp-5)&&NewDLim>0)NewDLim*=2.5; //ÏµÍ³ÎÂ¶È½Ó½ü¹ıÈÈ¹Ø»úµã£¬Ñ¸ËÙÌáÉı±ÈÀıÏµÊı¿ìËÙ
             -ÏÂµ÷¹¦ÂÊ
 159   2                                 
 160   2          if(NewDLim<(-2))NewDLim=(-2);                        //·çÉÈ°ÑÊÖÊÇÉ¢ÈÈÂı£¬¼ÓÈÈ¿ì£¬ËùÒÔÏŞÖÆ»ØÉıËÙ¶È×î´ó2
 161   2          else if(NewDLim<0)NewDLim=0;
 162   2          NewDLim=DutyLimit-(NewDLim*(float)ThermalDutyStepK);  //¼ÆËã»ı·ÖÎÂ¿Ø²ÎÊı
 163   2          //Õ¼¿Õ±ÈÏŞ·ù
 164   2          if(NewDLim>NoThrottleDutylim)NewDLim=NoThrottleDutylim;
 165   2          if(NewDLim<MaxThrottleDutylim)NewDLim=MaxThrottleDutylim;  //ÏŞÖÆÕ¼¿Õ±È·¶Î§
