 174   2          if(Data.Systemp>(PowerOffTemp-5)&&NewVLIM>0)NewVLIM*=2.5; //ÏµÍ³ÎÂ¶È½Ó½ü¹ıÈÈ¹Ø»úµã£¬Ñ¸ËÙÌáÉı±ÈÀıÏµÊı¿ìËÙ
