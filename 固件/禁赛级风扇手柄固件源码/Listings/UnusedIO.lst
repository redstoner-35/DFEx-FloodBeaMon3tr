   1          /****************************************************************************/
   2          /** \file UnusedIO.c
   3          /** \Author redstoner_35
   4          /** \Project Xtern Ripper Hyper Fan Ultra Edition
   5          /** \Description 这个文件负责操作GPIO寄存器，将系统内所有未使用的IO全部mask为低
   6                           电平对外输出模式，避免IO浮空引起的待机电流异常。
   7          **
   8          **  History:
   9                  2026年9月11日 Initial Release
  10          **  
  11          *****************************************************************************/
  12          /****************************************************************************/
  13          /*  include files
  14          *****************************************************************************/
  15          #include "GPIO.h"
  16          #include "PinDefs.h"
  17          #include "cms8s6990.h"
  18          
  19          /****************************************************************************/
  20          /* Global Function implementation - (in header files with 'extern')
  21          ****************************************************************************/ 
  22          void MaskUnusedIO(void)
  23            {
  24   1        //Mask掉无用的IO强制输出0 
  25   1        P0TRIS|=P0UnusedPIN;
  26   1        P1TRIS|=P1UnusedPIN;
  27   1        P2TRIS|=P2UnusedPIN;
  28   1        P3TRIS|=P3UnusedPIN;
  29   1        //所有无用的IO强制输出0
  30   1        P0&=~P0UnusedPIN;
  31   1        P1&=~P1UnusedPIN;
  32   1        P2&=~P2UnusedPIN;
  33   1        P3&=~P3UnusedPIN;
  34   1        //所有对外IO关闭上下拉电阻
  35   1        P0UP&=~P0UnusedPIN;
  36   1        P0RD&=~P0UnusedPIN;
  37   1        
  38   1        P1UP&=~P1UnusedPIN;
  39   1        P1RD&=~P1UnusedPIN;
  40   1          
  41   1        P2UP&=~P2UnusedPIN;
  42   1        P2RD&=~P2UnusedPIN;
  43   1          
  44   1        P3UP&=~P3UnusedPIN;
  45   1        P3RD&=~P3UnusedPIN;
  46   1        }
  47          /*****************************  End Of File  ******************************/


