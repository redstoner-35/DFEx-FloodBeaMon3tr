 128   1        buf=(float)3700-((float)300*(buf/(float)80));  //ãÐÖµ±ä»¯ÊýÖµ=(·çÉÈËÙ¶È¦¤Öµ/·çÉÈËÙ¶È±ä»¯·¶Î§µÄ×ÜÖµ)*µçÑ¹±
