 140   2              if(CellVoltage<(Thres-200))BattState=Battery_Low; //µç³ØµçÑ¹µÍÓÚãÐÖµÔòÇÐ»»µ½µçÁ¿µÍµÄ×´Ì¬
 141   2              break;
 142   2           //µç³ØµçÁ¿²»×ã
 143   2           case Battery_Low:
 144   2              if(CellVoltage>Thres)BattState=Battery_Mid; //µç³ØµçÑ¹¸ßÓÚ3.6£¬ÇÐ»»µ½µçÁ¿ÖÐµÈµÄ×´Ì¬
 145   2              if(CellVoltage<2950)BattState=Battery_VeryLow; //µç³ØµçÑ¹µÍÓÚ2.95£¬±¨¸æÑÏÖØ²»×ã
 146   2              break;
 147   2           //µç³ØµçÁ¿ÑÏÖØ²»×ã
 148   2           case Battery_VeryLow:
