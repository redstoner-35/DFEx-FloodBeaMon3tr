 129   1        Thres=(int)buf;
 130   1        //×´Ì¬»ú´¦Àí  
 131   1        switch(BattState) 
 132   1           {
 133   2           //µç³ØµçÁ¿³ä×ã
 134   2           case Battery_Plenty: 
 135   2              if(CellVoltage<Thres)BattState=Battery_Mid; //µç³ØµçÑ¹Ð¡ÓÚ3.7V£¬»Øµ½µçÁ¿ÖÐµÈ×´Ì¬
 136   2              break;
 137   2           //µç³ØµçÁ¿½ÏÎª³ä×ã
 138   2           case Battery_Mid:
