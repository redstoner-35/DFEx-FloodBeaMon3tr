 440          void BattDisplayTIM(void)
 441            {
 442   1        long buf;
 443   1        //µçÁ¿Æ½¾ùÄ£¿é¼ÆËã
 444   1        if(BattVolt.Count<VBattAvgCount)    
 445   1          {
 446   2          buf=(long)(Data.BatteryVoltage*1000);
 447   2          BattVolt.Count++;
 448   2          BattVolt.AvgBuf+=buf;
 449   2          if(BattVolt.Min>buf)BattVolt.Min=buf;
 450   2          if(BattVolt.Max<buf)BattVolt.Max=buf; //¼«Öµ¶ÁÈ¡
 451   2          }
 452   1        else //Æ½¾ù´ÎÊýµ½£¬¸üÐÂµçÑ¹
 453   1          {
 454   2          BattVolt.AvgBuf-=(long)BattVolt.Min+(long)BattVolt.Max; //È¥µô×î¸ß×îµÍ
 455   2          BattVolt.AvgBuf/=(long)(BattVolt.Count-2); //ÇóÆ½¾ùÖµ
 456   2          CellVoltage=(int)BattVolt.AvgBuf; //µÃµ½×îÖÕµÄµç³ØµçÑ¹(µ¥Î»mV)
 457   2          ResetBattAvg(); //¸´Î»»º´æ
 458   2          }
 459   1        //µç³ØµçÑ¹ÏÔÊ¾µÄ¼ÆÊ±Æ÷´¦Àí  
 460   1        if(CommonSysFSMTIM)CommonSysFSMTIM--;
 461   1        //µç³ØÏÔÊ¾¶¨Ê±Æ÷
 462   1        if(BattShowTimer)BattShowTimer--;
 463   1        }
