 147          /****************************************************************************/
 148          /* Global Function implementation - export to other file with 'extern'
 149          ****************************************************************************/   
 150            
 151          //加载定时器时间
 152          void LoadSleepTimer(void) 
 153            {
 154   1        //加载睡眠时间
 155   1        SleepTimer=8*SleepTimeOut;    
 156   1        } 
 157            
 158          //睡眠管理函数
 159          void SleepMgmt(void)
 160            {
 161   1        
 162   1        //非关机且仍然在显示电池电压的时候定时器复位禁止睡眠
 163   1        if(QueryIsSystemNotAllowToSleep())LoadSleepTimer();
 164   1        //允许睡眠开始倒计时
 165   1        if(SleepTimer>0)SleepTimer--;
 166   1        //立即进入睡眠阶段
 167   1        else SleepProcHandler();
 168   1        }
