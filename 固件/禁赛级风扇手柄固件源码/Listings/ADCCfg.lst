 185          static void ADC_WriteOutputBuf(int ADCResult,char Ch)
 186            {
 187   1        float Buf,Rt,Vadc;
 188   1        unsigned long NTCRES;
 189   1        extern bit IsEnable2SMode;
 190   1        //½øÐÐADC
 191   1        Rt=ADC_IsUsingIVREF()?ADCVREF:Data.MCUVDD; //¸ù¾Ý»ù×¼ÉèÖÃµÃµ½ADµ±Ç°µÄ»ù×¼µçÑ¹
 192   1        Vadc=(float)ADCResult*(Rt/(float)4096);//½«ADÖµ×ª»»ÎªÔ­Ê¼µçÑ¹
 193   1        //×´Ì¬»ú
 194   1        switch(Ch)
 195   1          {
 196   2          //¼ÆËã²Î¿¼µçÑ¹
 197   2          case ADC_INTVREFCh:
 198   2            Data.MCUVDD=ADCBGVREF*(float)4096/(float)ADCResult; //¼ÆËã³öMCUVDD(VREF)
 199   2            break; 
 200   2          //¼ÆËãµç³ØµçÑ¹
 201   2          case VBATInputAIN:
 202   2            #define VBatTotalResistor (VBattLowerResK+VBattUpperResK)
 203   2            Buf=(float)VBattLowerResK/(float)VBatTotalResistor;//¼ÆËã³ö·ÖÑ¹µç×èµÄÏµÊý
 204   2            Data.RawBattVolt=Vadc/Buf; //¸ù¾Ý·ÖÑ¹ÏµÊý·´ÍÆ³öµç³ØµçÑ¹
 205   2      
 206   2          
 207   2            if(!IsEnable2SMode)Data.BatteryVoltage=Data.RawBattVolt; //·Ç2SÄ£Ê½£¬Ö±½ÓÊ¹ÓÃÄ¿±êÖµ
 208   2            else Data.BatteryVoltage=Data.RawBattVolt/2.0f;            //2SÄ£Ê½Ôò»»ËãÎªµÈÐ§µç³ØµçÑ¹ 
 209   2            #undef VBatTotalResistor
 210   2            break;
 211   2          //¼ÆËãÎÂ¶È
 212   2          case NTCInputAIN:
 213   2            Rt=((float)NTCUpperResValueK*Vadc)/(Data.MCUVDD-Vadc);//µÃµ½NTC+µ¥Æ¬»úIOµ¼Í¨µç×èµÄ´«¸ÐÆ÷×èÖµ
 214   2            Rt*=1000; //½«×èÖµ´ÓKÅ·×ªÎª¦¸
 215   2            NTCRES=(unsigned long)Rt; //È¡Õû
 216   2            Data.Systemp=CalcNTCTemp(&Data.IsNTCOK,NTCRES); //¼ÆËãÎÂ¶È
 217   2            break;
 218   2          }
 219   1        }
