 148   1        while(--i);                             //ÑÓÊ±µÈ´ýÍ¨µÀÑ¡Í¨ºó¿ªÊ¼²ÉÑù
 149   1        ADC_StartConv();
 150   1        //½áÊø¶¨Òå
