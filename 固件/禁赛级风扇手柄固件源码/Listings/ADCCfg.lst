 133   1        //¼ì²éÏµÍ³ÊÇ·ñÕýÔÚ×ª»»
 134   1        if(ADCTemp.IsMissionProcessing)return;
 135   1        //½øÐÐ³õÊ¼»¯
 136   1        ADCTemp.avgbuf=0;
 137   1        ADCTemp.Count=0;
 138   1        ADCTemp.Index=index;
