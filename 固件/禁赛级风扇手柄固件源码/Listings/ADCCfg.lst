 155          static unsigned char ADC_ReadBackResult(int *Result)  
 156            {
 157   1        //ADCÎ´Íê³É±¾´Î×ª»»
 158   1        if(ADC_GetIfStillConv())return 0; 
 159   1        //ÊÕÈ¡½á¹û
