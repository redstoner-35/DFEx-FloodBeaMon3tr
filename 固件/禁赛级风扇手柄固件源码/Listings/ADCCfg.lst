 130   1        if(index>MaxIndexRange)return;          //´«Èë·Ç·¨µÄIndexÖµ£¬±ÜÃâÊý×éÒç³ö£¬×èÖ¹¼ÌÐøÔËÐÐ
 131   1        i=ADCConvertQueue[index];
