 166   2          }
 167   1        //Íê³É×ª»»£¬·µ»Ø½á¹û²¢×¼±¸¿ÉÒÔÌá½»ÐÂµÄÈÎÎñ
 168   1        ADCTemp.avgbuf/=(long)ADCTemp.Count;
 169   1        *Result=(int)ADCTemp.avgbuf;       //·µ»Ø½á¹û
 170   1        ADCTemp.IsMissionProcessing=false; //ÈÎÎñÒÑ´¦ÀíÍê±Ï
 171   1        return 1; 
