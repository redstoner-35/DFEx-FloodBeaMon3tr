  11          /****************************************************************************/
  12          /*  include files
  13          *****************************************************************************/
  14          #include "cms8s6990.h"
  15          #include "SysReset.h"
  16          
  17          /****************************************************************************/
  18          /*  Global function implantation(called by 'extern')
  19          ****************************************************************************/ 
  20          
  21          //生成系统复位
  22          #pragma optimize(0)
  23          void TriggerSoftwareReset(void)
  24            {
  25   1        EA=0;
  26   1        _nop_();
  27   1        TA=0xAA;
  28   1        TA=0x55;  //往TA寄存器写55AA解锁
  29   1        WDCON=0x80;  //令WDTCON[7]=1，触发系统复位
  30   1        while(1);
  31   1        }
  32          
  33          //清除软件复位标志位
  34          #pragma optimize(0)
  35          void ClearSoftwareResetFlag(void)
  36            {
  37   1        EA=0;
  38   1        _nop_();
  39   1        TA=0xAA;
  40   1        TA=0x55;  //往TA寄存器写55AA解锁
  41   1        WDCON&=0x7F;  //令WDTCON[7]=0，触发系统复位
  42   1        }
  43          /*****************************  End Of File  ******************************/


