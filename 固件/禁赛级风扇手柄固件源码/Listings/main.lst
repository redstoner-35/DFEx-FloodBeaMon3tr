  38          void main()
  39            {
  40   1        bit TaskSel=0;
  41   1        //启动系统定时器提供系统定时和延时函数
  42   1        StartSystemTimeBase(); 
  43   1        ClearSoftwareResetFlag();
  44   1        //初始化外设
  45   1        LED_Init(); //初始化侧按LED   
  46   1        ADC_Init(); //初始化ADC
  47   1        WaitBatteryVoltageOK(); //等待电池电压稳定
  48   1        SideKeyInit(); //初始化按键控制器
  49   1        PWM_Init(); //启动PWM定时器
  50   1        OutputChannel_Init(); //初始化输出通道
  51   1        ModeFSMInit(); //初始化模式状态机
  52   1        BattCellCountConfig(); //电池节数识别处理
  53   1        ThermalSystem_Init();  //初始化温控系统
C51 COMPILER V9.60.7.0   MAIN                                                              10/31/2026 08:53:28 PAGE 2   

  54   1        MaskUnusedIO(); //屏蔽掉不用的IO
  55   1        DisplayVBattAtStart(1); //上电时显示电池电压  
  56   1        LoadSleepTimer();       //进入系统前加载一遍睡眠定时器
  57   1        EnableADCAsync();       //使能ADC异步模式
  58   1        //主循环
  59   1        while(1)
  60   1          {
  61   2          //实时处理  
  62   2          SystemTelemHandler();//对ADC执行采集获取系统状态
  63   2            
  64   2          //处理按键事务，如果有按键按下，则加载睡眠定时器重置休眠延时  
  65   2          SideKey_LogicHandler(); 
  66   2          if(IsKeyEventOccurred())LoadSleepTimer(); 
  67   2      
  68   2          BatteryTelemHandler(); //处理电池遥测 
  69   2          OverHeatProtect();  //处理过热保护
  70   2          ModeSwitchFSM(); //挡位变换状态机
  71   2          TempDegDetect();  //温度降额计算
  72   2          OutputChannel_Calc(); //输出通道运算
  73   2          PWM_OutputCtrlHandler(); //处理PWM输出事务      
  74   2          //8Hz定时处理
  75   2          if(!SysHFBitFlag)continue; //时间没到，跳过处理
  76   2          if(!TaskSel)
  77   2            {
  78   3            //Task0，处理计算量比较大的任务
  79   3            LEDControlHandler();//侧按指示LED控制函数
  80   3            SideKey_TIM_Callback();//侧按按键的监测定时器处理
  81   3            TurboTimedStepDownPROC(); //极速定时降档处理
  82   3            TempSensorStallDetect();   //处理温度检测
  83   3            SleepMgmt(); //睡眠处理
  84   3            
  85   3            //任务处理完毕，处理task 1
  86   3            TaskSel=1;
  87   3            }
  88   2          else
  89   2            {   
  90   3            //Task1，处理计算量比较小的计时任务
  91   3            BattAlertTIMHandler(); //电池警报处理
  92   3            HoldSwitchGearCmdHandler(); //长按换挡命令处理
  93   3            BattDisplayTIM(); //电池电量显示TIM
  94   3            RampConfigAutoSaveHandler(); //无级调速自动保存处理
  95   3              
  96   3            //任务处理完毕，处理task 0
  97   3            TaskSel=0;
  98   3            }
  99   2          //处理完毕，令flag清零
 100   2          SysHFBitFlag=0; 
 101   2          }
 102   1        }
