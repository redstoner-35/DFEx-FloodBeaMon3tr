  54          
  55          /****************************************************************************/
  56          /* Global Function implementation - Initialization
  57          ****************************************************************************/ 
  58          
  59          //关闭PWM定时器
  60          void PWM_DeInit(void)
  61            {
  62   1        //配置为普通GPIO
  63   1        GPIO_SetMUXMode(FanPWMIOG,FanPWMIOx,GPIO_AF_GPIO);
  64   1        GPIO_SetMUXMode(CVDACIOG,CVDACIOx,GPIO_AF_GPIO);
  65   1        //关闭PWM模块
  66   1        PWMCNTCLR=0x11; //复位PWM0和4的计数器
  67   1        PWMOE=0x00;
  68   1        PWMCNTE=0x00;   //关闭PWM计数器
  69   1        PWM45PSC=0x00;
  70   1        PWM01PSC=0x00;  //关闭PWM分频器时钟
  71   1        }
  72          
  73          //上传PWM值
  74          static void UploadPWMValue(void)  
  75            {
  76   1        PWMLOADEN=0x11; //加载通道0的PWM值
  77   1        while(PWMLOADEN&0x11); //等待加载结束
  78   1        }
  79              
  80          //PWM定时器初始化
  81          void PWM_Init(void)
  82            {
  83   1        GPIOCfgDef PWMInitCfg;
  84   1        //设置结构体
  85   1        PWMInitCfg.Mode=GPIO_Out_PP;
  86   1        PWMInitCfg.Slew=GPIO_Fast_Slew;   
  87   1        PWMInitCfg.DRVCurrent=GPIO_High_Current; //推FanPWM，不需要很高的上升斜率
  88   1        //配置GPIO
  89   1        CVDACPin=0;
  90   1        FanPWMPin=0;        //令FanPWM的输出在非PWM模式下始终输出0
  91   1        GPIO_ConfigGPIOMode(CVDACIOG,GPIOMask(CVDACIOx),&PWMInitCfg); 
  92   1        GPIO_ConfigGPIOMode(FanPWMIOG,GPIOMask(FanPWMIOx),&PWMInitCfg); 
  93   1        //配置PWM发生器
  94   1        PWMCON=0x00;    //PWM通道为六通道独立模式，向下计数，关闭非对称计数功能 
  95   1        PWMOE=0x11;     //打开PWM输出通道0和4
  96   1        PWM01PSC=0x01;  
  97   1        PWM45PSC=0x01;  //打开预分频器和计数器时钟 
  98   1        PWM0DIV=0xff;   
  99   1        PWM4DIV=0xff;   //令Fpwmcnt=Fsys=48MHz(不分频)
 100   1        PWMPINV=0x00;   //所有通道均设置为正常输出模式
 101   1        PWMCNTM=0x11;   //通道0和4配置为自动加载模式
 102   1        PWMCNTCLR=0x11; //初始化PWM的时候复位通道0和4的定时器
 103   1        PWMDTE=0x00;    //关闭死区时间
 104   1        PWMMASKD=0x00; 
 105   1        PWMMASKE=0x11;  //PWM掩码功能启用，默认状态下禁止通道0和4输出
 106   1        //配置周期数据
 107   1        PWMP0H=(PWMStepConstant>>8)&0xFF;
 108   1        PWMP0L=PWMStepConstant&0xFF;  
 109   1        PWMP4H=(FanPWMStepConstantVal>>8)&0xFF;
 110   1        PWMP4L=FanPWMStepConstantVal&0xFF;
 111   1        //配置占空比数据
 112   1        PWMD0H=0;
 113   1        PWMD4H=0x0;
 114   1        PWMD0L=0; 
 115   1        PWMD4L=0x0;
C51 COMPILER V9.60.7.0   PWM                                                               10/31/2026 08:53:27 PAGE 3   

 116   1        //初始化变量
 117   1        CVDACTargetDuty=0;
 118   1        FanPWMDuty=0;
 119   1        IsPWMLoading=0; 
 120   1        IsNeedToUploadPWM=0;
 121   1        //启用PWM
 122   1        PWM_Enable();
 123   1        UploadPWMValue(); 
 124   1        //PWM初始化完毕，将引脚启用为复用功能
 125   1        GPIO_SetMUXMode(FanPWMIOG,FanPWMIOx,GPIO_AF_PWMCH4);
 126   1        GPIO_SetMUXMode(CVDACIOG,CVDACIOx,GPIO_AF_PWMCH0);
 127   1        }
