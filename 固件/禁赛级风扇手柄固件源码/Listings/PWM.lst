  15          #include "cms8s6990.h"
  16          #include "PinDefs.h"
  17          #include "GPIO.h"
  18          #include "PWMCfg.h"
  19          
  20          /****************************************************************************/
  21          /*  Local pre-processor symbols/macros('#define') For Parameter definition
  22          ****************************************************************************/
  23          #define SysFreq 48000000 //系统时钟频率(单位Hz)
  24          #define PWMFreq 6000 //PWM频率(单位Hz)  
  25          #define FanPWMFreq 20000  //风扇的PWM频率(单位Hz) 
  26            
  27          /****************************************************************************/
  28          /*  Local pre-processor symbols/macros('#define') For Parameter parsing
  29          
  30          Note: 以下的宏请勿修改，否则会导致PWM模块工作异常！
  31          ****************************************************************************/
  32          #define PWMStepConstant (SysFreq/PWMFreq)-1         
  33          #define FanPWMStepConstantVal (SysFreq/FanPWMFreq)-1  //PWM周期自动定义
  34          
  35          //PWM使能操作
  36          #define PWM_Enable()  do{PWMFBKC=0x00;PWMCNTE=0x11;}while(0) //使能PWM输出 
  37          
  38          /****************************************************************************/
  39          /*  Global variable definitions(declared in header file with 'extern')
  40          ****************************************************************************/
  41          xdata float CVDACTargetDuty;
  42          xdata unsigned int FanPWMDuty; //风扇和恒压DAC的目标占空比
  43          bit IsNeedToUploadPWM;         //是否需要更新PWM
  44          
  45          /****************************************************************************/
  46          /*  Local variable and special Register definitions('static')
  47          ****************************************************************************/
  48          static bit IsPWMLoading; //PWM正在加载中
  49          static bit IsNeedToEnableOutput; //是否需要启用输出
  50          static bit IsNeedToEnableMOS; //是否需要使能MOS管
  51          
  52          sbit FanPWMPin=FanPWMIOP^FanPWMIOx;
  53          sbit CVDACPin=CVDACIOP^CVDACIOx;
