 129          /****************************************************************************/
 130          /* Global Function implementation - Special Operation
 131          ****************************************************************************/   
 132            
 133          //获取风扇PWM的数值常量
 134          int FanPWMStepConstant(void)
 135            {
 136   1        /*****************************************************
 137   1        特殊的函数，返回一个常量值供原来获取PWM常量的函数进行运算
 138   1        将硬件底层的参数宏和上层应用调用隔离。  
 139   1          
 140   1        这里不用担心函数返回的开销，因为编译器检测到这个函数只返
 141   1        回一个宏定义的常量，内部没有其他任何操作的话就不会生成函
 142   1        数进入和返回的入栈压栈和RETI代码。
 143   1        *****************************************************/
 144   1        return FanPWMStepConstantVal;
 145   1        }
 146            
 147          /****************************************************************************/
 148          /* Global Function implementation - Logic Handler
 149          ****************************************************************************/ 
 150          
 151          //根据PWM结构体内的配置进行输出
 152          void PWM_OutputCtrlHandler(void)  
 153            {
 154   1        int value;
 155   1        float buf;
 156   1        //当前系统未请求加载
 157   1        if(!IsNeedToUploadPWM)return; //不需要加载
 158   1        //当次加载已开始，进行结束监测
 159   1        else if(IsPWMLoading) 
 160   1          {
 161   2          if(PWMLOADEN&0x11)return;//加载寄存器复位为0，表示加载成功
 162   2          //加载结束
 163   2          if(IsNeedToEnableMOS)PWMMASKE&=0xEF;
 164   2          else PWMMASKE|=0x10;
 165   2          if(IsNeedToEnableOutput)PWMMASKE&=0xFE;
 166   2          else PWMMASKE|=0x01;   //更新PWMMASKE寄存器根据输出状态启用对应的通道
 167   2          IsNeedToUploadPWM=0;
 168   2          IsPWMLoading=0;  //正在加载状态为清除
 169   2          }
 170   1        //当次加载已被请求开始，进行加载处理
 171   1        else
 172   1          {
 173   2          //PWM占空比参数限制
 174   2          if(CVDACTargetDuty>100)CVDACTargetDuty=100;
 175   2          if(CVDACTargetDuty<0)CVDACTargetDuty=0;
 176   2          if(FanPWMDuty>FanPWMStepConstantVal)FanPWMDuty=FanPWMStepConstantVal;
 177   2          //根据PWM数值选择MASK寄存器是否启用
C51 COMPILER V9.60.7.0   PWM                                                               10/31/2026 08:53:27 PAGE 4   

 178   2          IsNeedToEnableOutput=CVDACTargetDuty>0?1:0; //是否需要启用输出
 179   2          IsNeedToEnableMOS=FanPWMDuty?1:0;  //配置是否需要使能FET
 180   2          //配置寄存器装载CV DAC的PWM设置数值
 181   2          buf=CVDACTargetDuty*(float)PWMStepConstant;
 182   2          buf/=(float)100;
 183   2          value=(int)buf;
 184   2          PWMD0H=(value>>8)&0xFF;
 185   2          PWMD0L=value&0xFF;    
 186   2          //装载风扇的PWM数值
 187   2          value=FanPWMStepConstantVal-FanPWMDuty;  //因为风扇PWM电路的输出电平位移自带反相器所以需要输出反过来的占
             -空比
 188   2          if(!value)IsNeedToEnableMOS=0; //PWM输出100%的时候直接让输出MOS关掉就行了
 189   2          PWMD4H=(value>>8)&0xFF;
 190   2          PWMD4L=value&0xFF;      
 191   2          //PWM寄存器数值已装入，应用数值   
 192   2          IsPWMLoading=1; //标记加载过程进行中
 193   2          PWMLOADEN|=0x11; //开始加载
 194   2          }
 195   1        }
